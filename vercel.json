{
  "redirects": [
    {
      "source": "/demo",
      "destination": "/?demo=1",
      "permanent": false
    },
    {
      "source": "/demo/",
      "destination": "/?demo=1",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

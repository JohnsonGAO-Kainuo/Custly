{
  "functions": {
    "api/stripe-webhook.ts": {
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/demo",
      "destination": "/?demo=1",
      "permanent": false
    },
    {
      "source": "/demo/",
      "destination": "/?demo=1",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/pb/(.*)",
      "destination": "https://pb-custly.kainuotech.com/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
